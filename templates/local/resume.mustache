{{!
    @template format_sectiontabs/local/resume

    "Resume where I left off" link on the course home: last section consulted and its last subsection opened.

    Example context (json):
    {
        "url": "#",
        "style": "--gtabs-theme:#0f6cbf;--gtabs-theme-text:#ffffff;",
        "sectionname": "Bloc de compétence 2 : Actes quotidiens",
        "subname": "Exercices, tests et corrections"
    }
}}
<div class="gresume" style="{{style}}">
    <a class="gresume-link" href="{{url}}">
        <span class="gresume-kind">{{#str}} resume, format_sectiontabs {{/str}}</span>
        <span class="gresume-name">{{sectionname}}{{#subname}} <span aria-hidden="true">›</span><span class="gtabs-sr">,</span> {{subname}}{{/subname}}</span>
        <span class="gresume-arrow" aria-hidden="true">→</span>
    </a>
</div>
