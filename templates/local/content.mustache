{{!
    @template format_sectiontabs/local/content

    Tab bar followed by the standard course content.

    Example context (json):
    {
        "gtabs": {
            "leftmenu": true,
            "hastabs": true,
            "sections": [
                {"fullname": "Accueil", "title": "Accueil", "url": "#", "active": true}
            ],
            "style": "--gtabs-active:#ecb21e;--gtabs-active-border:#2b1a10;",
            "tabs": [
                {"name": "Accueil", "fullname": "Accueil", "title": "Accueil", "url": "#", "active": true},
                {"name": "Bloc 1", "title": "Bloc 1 : Actes essentiels", "url": "#"}
            ]
        },
        "sections": [],
        "format": "sectiontabs",
        "title": "Course",
        "sectionreturn": "null",
        "pagesectionid": "null"
    }
}}
{{#gtabs.hastabs}}
    {{#gtabs}}
        {{> format_sectiontabs/local/tabs }}
    {{/gtabs}}
{{/gtabs.hastabs}}
{{#gtabs.leftmenu}}
<div class="gtabs-layout" style="{{gtabs.style}}">
    {{#gtabs}}
        {{> format_sectiontabs/local/sidemenu }}
    {{/gtabs}}
    <div class="gtabs-main">
        {{#gresume}}
            {{> format_sectiontabs/local/resume }}
        {{/gresume}}
        {{#gsubtabs}}
            {{> format_sectiontabs/local/subtabs }}
        {{/gsubtabs}}
        {{> core_courseformat/local/content }}
        {{! On a section page, Moodle hides the "Add section" button: it is displayed here in editing mode. }}
        {{#singlesection}}
            {{#numsections}}
                {{> core_courseformat/local/content/addsection }}
            {{/numsections}}
        {{/singlesection}}
        {{#gnav}}
            {{> format_sectiontabs/local/navigation }}
        {{/gnav}}
    </div>
</div>
{{/gtabs.leftmenu}}
{{^gtabs.leftmenu}}
    {{#gresume}}
        {{> format_sectiontabs/local/resume }}
    {{/gresume}}
    {{#gsubtabs}}
        {{> format_sectiontabs/local/subtabs }}
    {{/gsubtabs}}
    {{> core_courseformat/local/content }}
    {{#singlesection}}
        {{#numsections}}
            {{> core_courseformat/local/content/addsection }}
        {{/numsections}}
    {{/singlesection}}
    {{#gnav}}
        {{> format_sectiontabs/local/navigation }}
    {{/gnav}}
{{/gtabs.leftmenu}}
