{{!
    @template format_sectiontabs/local/sidemenu

    Vertical list of the course sections, displayed on the left of the course content.

    Example context (json):
    {
        "sections": [
            {"fullname": "Accueil et informations pratiques", "title": "Accueil et informations pratiques", "url": "#", "active": true},
            {"fullname": "Bloc 1 : Actes essentiels", "title": "Bloc 1 : Actes essentiels", "url": "#", "hidden": true},
            {"fullname": "Bloc 2", "title": "Bloc 2", "url": "#", "unavailable": true}
        ]
    }
}}
<nav class="gtabs-side" aria-label="{{#str}} sidemenunav, format_sectiontabs {{/str}}">
    <ul class="gtabs-side-list">
        {{#sections}}
        <li class="gtabs-side-item">
            {{#unavailable}}
            <span class="gtabs-side-link gtabs-unavailable{{#active}} gtabs-side-active{{/active}}" title="{{title}}"{{#active}} aria-current="page"{{/active}}>{{#complete}}<span class="gtabs-check" aria-hidden="true">✓</span>{{/complete}}{{{fullname}}}{{#complete}}<span class="gtabs-sr"> ({{#str}} completed, format_sectiontabs {{/str}})</span>{{/complete}}<span class="gtabs-sr"> ({{#str}} notavailable, format_sectiontabs {{/str}})</span></span>
            {{/unavailable}}
            {{^unavailable}}
            <a class="gtabs-side-link{{#active}} gtabs-side-active{{/active}}{{#hidden}} gtabs-hidden{{/hidden}}" href="{{url}}" title="{{title}}"{{#active}} aria-current="page"{{/active}}>{{#complete}}<span class="gtabs-check" aria-hidden="true">✓</span>{{/complete}}{{{fullname}}}{{#complete}}<span class="gtabs-sr"> ({{#str}} completed, format_sectiontabs {{/str}})</span>{{/complete}}{{#hidden}}<span class="gtabs-sr"> ({{#str}} hiddenfromstudents, format_sectiontabs {{/str}})</span>{{/hidden}}</a>
            {{/unavailable}}
        </li>
        {{/sections}}
    </ul>
</nav>
