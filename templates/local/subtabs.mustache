{{!
    @template format_sectiontabs/local/subtabs

    Tabs of the subsections of a section: only the subsection of the selected tab is displayed.

    Example context (json):
    {
        "uniqid": "gsubtabs1",
        "sectionid": 42,
        "courseid": 7,
        "resume": true,
        "style": "--gtabs-active:#ecb21e;",
        "subtabs": [
            {"cmid": 10, "num": 12, "name": "Classe virtuelle", "title": "Classe virtuelle", "active": true},
            {"cmid": 11, "num": 13, "name": "S'informer", "title": "S'informer", "hidden": true},
            {"cmid": 12, "num": 14, "name": "Dire", "title": "Dire", "unavailable": true}
        ],
        "editing": true
    }
}}
<div id="{{uniqid}}" class="gsubtabs" style="{{style}}" data-sectionid="{{sectionid}}" data-courseid="{{courseid}}"{{#resume}} data-resume="1"{{/resume}}>
    <ul class="gsubtabs-list" role="tablist" aria-label="{{#str}} subtabsnav, format_sectiontabs {{/str}}">
        {{#subtabs}}
        <li class="gsubtabs-item" role="presentation">
            <a class="gsubtabs-tab{{#active}} gsubtabs-active{{/active}}{{#hidden}} gtabs-hidden{{/hidden}}{{#unavailable}} gsubtabs-unavailable{{/unavailable}}"
               id="{{uniqid}}-tab-{{cmid}}" href="#section-{{num}}" role="tab" aria-controls="module-{{cmid}}"
               aria-selected="{{#active}}true{{/active}}{{^active}}false{{/active}}" tabindex="{{#active}}0{{/active}}{{^active}}-1{{/active}}"
               title="{{title}}" data-gsubtab="{{cmid}}" data-num="{{num}}">{{#complete}}<span class="gtabs-check" aria-hidden="true">✓</span>{{/complete}}{{{name}}}{{#complete}}<span class="gtabs-sr"> ({{#str}} completed, format_sectiontabs {{/str}})</span>{{/complete}}{{#hidden}}<span class="gtabs-sr"> ({{#str}} hiddenfromstudents, format_sectiontabs {{/str}})</span>{{/hidden}}{{#unavailable}}<span class="gtabs-sr"> ({{#str}} notavailable, format_sectiontabs {{/str}})</span>{{/unavailable}}</a>
        </li>
        {{/subtabs}}
        {{#editing}}
        <li class="gsubtabs-item gsubtabs-item-all" role="presentation">
            <a class="gsubtabs-tab gsubtabs-all" id="{{uniqid}}-tab-all" href="#" role="tab" aria-selected="false" tabindex="-1"
               data-gsubtab="all">{{#str}} subtabsshowall, format_sectiontabs {{/str}}</a>
        </li>
        {{/editing}}
    </ul>
</div>
{{#js}}
(function() {
    var root = document.getElementById('{{uniqid}}');
    if (!root) {
        return;
    }
    var tabs = Array.prototype.slice.call(root.querySelectorAll('[data-gsubtab]'));
    // The hidden subsections are hidden by a style rule rather than a class on the
    // elements, so that they stay hidden when the course editor re-renders them.
    // Per section memory (this browser tab only): last opened subsection, and the subsections already seen.
    var storekey = 'format_sectiontabs:' + root.dataset.sectionid + ':';
    var load = function(name) {
        try {
            return window.sessionStorage.getItem(storekey + name);
        } catch (e) {
            return null;
        }
    };
    var save = function(name, value) {
        try {
            window.sessionStorage.setItem(storekey + name, value);
        } catch (e) {
            // Storage unavailable: no memory, the first tab is opened.
        }
    };
    var rules = document.createElement('style');
    document.head.appendChild(rules);
    var show = function(tab) {
        var hidden = [];
        tabs.forEach(function(other) {
            var on = (other === tab);
            other.classList.toggle('gsubtabs-active', on);
            other.setAttribute('aria-selected', on ? 'true' : 'false');
            other.setAttribute('tabindex', on ? '0' : '-1');
            if (other.dataset.gsubtab === 'all') {
                return;
            }
            if (!on && tab.dataset.gsubtab !== 'all') {
                hidden.push('#region-main li[data-for="cmitem"][data-id="' + other.dataset.gsubtab + '"]');
            }
        });
        rules.textContent = hidden.length ? hidden.join(',') + '{display:none !important;}' : '';
        // On a phone the subtabs scroll horizontally: keep the selected one in view.
        var list = root.querySelector('.gsubtabs-list');
        if (list && list.scrollWidth > list.clientWidth && tab.dataset.gsubtab !== 'all') {
            list.scrollLeft = tab.offsetLeft - list.offsetLeft - (list.clientWidth - tab.offsetWidth) / 2;
        }
        if (tab.dataset.gsubtab !== 'all') {
            save('last', tab.dataset.gsubtab);
        }
        updateNav(tab);
    };
    // Previous / next bar: previous / next subsection while there is one, else previous / next section.
    var nav = document.querySelector('#region-main .gnav');
    var subtabs = tabs.filter(function(t) {
        return t.dataset.gsubtab !== 'all';
    });
    // Name of the data-str-{direction}{kind} attribute in the dataset (e.g. strPrevsection).
    var strkey = function(direction, kind) {
        return 'str' + direction.charAt(0).toUpperCase() + direction.slice(1) + kind;
    };
    var configure = function(link, direction, subtab) {
        if (!link) {
            return;
        }
        var kind = link.querySelector('.gnav-kindtext');
        var name = link.querySelector('.gnav-name');
        if (subtab) {
            link.href = '#section-' + subtab.dataset.num;
            link.dataset.gsubtabTarget = subtab.id;
            kind.textContent = nav.dataset[strkey(direction, 'subsection')];
            name.textContent = subtab.getAttribute('title');
            link.classList.remove('d-none');
            return;
        }
        delete link.dataset.gsubtabTarget;
        var url = nav.dataset[direction + 'Url'];
        kind.textContent = nav.dataset[strkey(direction, 'section')];
        name.textContent = nav.dataset[direction + 'Name'] || '';
        link.href = url || '#';
        link.classList.toggle('d-none', !url);
    };
    var updateNav = function(tab) {
        if (!nav) {
            return;
        }
        var index = subtabs.indexOf(tab);
        configure(nav.querySelector('.gnav-prev'), 'prev', index > 0 ? subtabs[index - 1] : null);
        configure(nav.querySelector('.gnav-next'), 'next',
            index >= 0 && index < subtabs.length - 1 ? subtabs[index + 1] : null);
    };
    var select = function(tab, focus) {
        show(tab);
        // "Resume where I left off": remember the subsection the user opened (user preference, any device).
        if (root.dataset.resume && tab.dataset.gsubtab !== 'all') {
            require(['core_user/repository'], function(repository) {
                repository.setUserPreference('format_sectiontabs_lastsub_' + root.dataset.courseid, tab.dataset.gsubtab)
                    .catch(function() {
                        // Not saved: the link to resume simply opens the section.
                    });
            });
        }
        if (focus) {
            tab.focus();
        }
        if (window.history && window.history.replaceState) {
            var hash = tab.dataset.num ? '#section-' + tab.dataset.num : '';
            window.history.replaceState(null, '', window.location.pathname + window.location.search + hash);
        }
    };
    // Tab named by the address: #section-N (subsection), or #module-ID of a subsection or of an activity
    // inside a subsection (Moodle 5 uses it after adding or editing them). Null when none.
    var fromHash = function() {
        var hash = window.location.hash;
        var found = null;
        var match = /^#section-(\d+)$/.exec(hash);
        if (match) {
            found = subtabs.filter(function(t) {
                return t.dataset.num === match[1];
            })[0];
        }
        match = /^#module-(\d+)$/.exec(hash);
        if (!found && match) {
            var target = document.getElementById('module-' + match[1]);
            var item = target && target.closest('#region-main li[data-for="cmitem"].modtype_subsection');
            if (item) {
                found = subtabs.filter(function(t) {
                    return t.dataset.gsubtab === item.dataset.id;
                })[0];
            }
        }
        return found || null;
    };
    var byId = function(cmid) {
        return subtabs.filter(function(t) {
            return t.dataset.gsubtab === cmid;
        })[0] || null;
    };
    // Subsections that were not there on the last visit: just created (Moodle 4.5 returns to the section
    // without saying which one was added).
    var ids = subtabs.map(function(t) {
        return t.dataset.gsubtab;
    });
    var known = null;
    try {
        known = JSON.parse(load('known'));
    } catch (e) {
        known = null;
    }
    save('known', JSON.stringify(ids));
    var newtabs = Array.isArray(known) ? subtabs.filter(function(t) {
        return known.indexOf(t.dataset.gsubtab) === -1;
    }) : [];
    var initial = function() {
        return fromHash() || newtabs[newtabs.length - 1] || byId(load('last')) ||
            root.querySelector('.gsubtabs-active') || tabs[0];
    };
    tabs.forEach(function(tab, index) {
        tab.addEventListener('click', function(e) {
            e.preventDefault();
            select(tab, false);
        });
        // Keyboard navigation of the WAI-ARIA tabs pattern.
        tab.addEventListener('keydown', function(e) {
            var target = null;
            if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
                target = tabs[(index + 1) % tabs.length];
            } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
                target = tabs[(index - 1 + tabs.length) % tabs.length];
            } else if (e.key === 'Home') {
                target = tabs[0];
            } else if (e.key === 'End') {
                target = tabs[tabs.length - 1];
            } else if (e.key === ' ') {
                target = tab;
            }
            if (target) {
                e.preventDefault();
                select(target, true);
            }
        });
    });
    if (nav) {
        nav.querySelectorAll('.gnav-link').forEach(function(link) {
            link.addEventListener('click', function(e) {
                var target = link.dataset.gsubtabTarget && document.getElementById(link.dataset.gsubtabTarget);
                if (!target) {
                    // Link to another section: normal navigation.
                    return;
                }
                e.preventDefault();
                select(target, true);
                root.scrollIntoView({block: 'start'});
            });
        });
    }
    window.addEventListener('hashchange', function() {
        var tab = fromHash();
        if (tab) {
            show(tab);
        }
    });
    show(initial());
})();
{{/js}}
